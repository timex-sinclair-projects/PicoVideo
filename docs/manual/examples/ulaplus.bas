10 REM ULAplus: load a 64-color palette and show it
20 BORDER 0: PAPER 0: INK 7: BRIGHT 0: FLASH 0: CLS
30 RESTORE 500
40 FOR c=0 TO 63: READ v: OUT 48955,c: OUT 65339,v: NEXT c
50 FOR k=0 TO 3
60 LET f=INT (k/2): LET b=k-2*f: LET y=k*5
70 PRINT AT y,0;"CLUT ";k;": FLASH ";f;", BRIGHT ";b
80 FOR p=0 TO 7
90 PRINT AT y+1,p*4; PAPER p; BRIGHT b; FLASH f;"    "
100 PRINT AT y+2,p*4; INK p; BRIGHT b; FLASH f;CHR$ 143+CHR$ 143+CHR$ 143+" "
110 NEXT p: NEXT k
120 OUT 48955,64: OUT 65339,1: REM palette on
130 PRINT AT 21,0;"Press a key to switch it off": PAUSE 0
140 OUT 48955,64: OUT 65339,0: REM palette off
150 STOP
500 DATA 0,2,20,22,160,162,180,182,0,2,20,22,160,162,180,182
510 DATA 0,3,28,31,224,227,252,255,0,3,28,31,224,227,252,255
520 DATA 0,36,72,109,145,182,218,255,255,218,182,145,109,72,36,0
530 DATA 28,124,220,236,225,163,39,87,5,9,49,85,121,157,221,254
